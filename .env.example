# OpenAI
OPENAI_API_KEY=""

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=20

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=transcripts

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# LightRAG Storage Backends
KV_STORAGE=PGKVStorage
VECTOR_STORAGE=PGVectorStorage
GRAPH_STORAGE=PGGraphStorage
DOC_STATUS_STORAGE=PGDocStatusStorage

# RAG
WORKING_DIR=./rag
WORKSPACE=rag_workspace
VECTOR_NAMESPACE=rag_vectors
TRANSCRIPT_DIR=./data/transcripts

# LLM & Embedding Models
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MAX_TOKEN_SIZE=8192

# Diarization
DIARIZATION_SEGMENT_MINUTES=10
NEMO_CONFIG_URL=https://raw.githubusercontent.com/NVIDIA/NeMo/main/examples/speaker_tasks/diarization/conf/inference/diar_infer_meeting.yaml
SPEAKER_SIMILARITY_THRESHOLD=0.75

# Transcription (STT)
WHISPER_MODEL=stojchevamarija/whisper-large-v3-turbo-mkd-finetuned

# Chunking
BLOCK_WINDOW_SIZE=5
CONTEXTUAL_WINDOW_SIZE=3

